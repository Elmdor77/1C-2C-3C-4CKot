<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VocabularyFlashcardsMauiApp"
             x:Class="VocabularyFlashcardsMauiApp.MainPage"
             Title="Fiszki">

    <VerticalStackLayout Padding="24" Spacing="20">

        <CarouselView x:Name="FlashcardsCarousel"
                      HeightRequest="220"
                      Loop="False"
                      IndicatorView="CardIndicator"
                      PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="local:Flashcard">
                    <Border Margin="10"
                            Padding="20"
                            StrokeShape="RoundRectangle 16"
                            Stroke="Gray"
                            StrokeThickness="2">
                        <Label Text="{Binding English}"
                               FontSize="40"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <IndicatorView x:Name="CardIndicator"
                       HorizontalOptions="Center"
                       IndicatorColor="LightGray"
                       SelectedIndicatorColor="DarkSlateBlue" />

        <Button Text="Pokaż tłumaczenie"
                Clicked="OnShowTranslationClicked" />

        <Label x:Name="TranslationLabel"
               Text=""
               FontSize="28"
               HorizontalOptions="Center"
               MinimumHeightRequest="40" />

        <Button Text="Zacznij od początku"
                Clicked="OnRestartClicked" />

    </VerticalStackLayout>
</ContentPage>
