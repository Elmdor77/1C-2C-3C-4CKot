<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SimpleCalculatorApp.MainPage"
             Title="Prosty kalkulator">

    <StackLayout Padding="30.0" Spacing="25">
        <Label
            Background="IndianRed"
            BackgroundColor="LightCoral"
            FontAttributes="Bold"
            FontFamily="Arial"
            FontSize="20"
            Text="Podaj pierwszą liczbę"/>

        <Entry x:Name="FirstNumberEntry"/>
        <StackLayout Orientation="Horizontal">
            <Label Text="Podaj drugą liczbę:" VerticalTextAlignment="Center"/>
            <Entry BackgroundColor="BlanchedAlmond" x:Name="SecondNumberEntry"/>
        </StackLayout>
            <Button Text="Oblicz" Clicked="Button_Clicked"/>
            <Label x:Name="ResultLabel"/>




        </StackLayout>

</ContentPage>
