<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}"
             x:Class="OrderCalcMauiAppp.MainPage">

    <ScrollView>
        <VerticalStackLayout>
            <Entry Placeholder="Nazwa produktu" x:Name="nazwa" Text="{Binding nazwa}"></Entry>
            <Entry Placeholder="Cena produktu" x:Name="cena" Text="{Binding cena}"></Entry>
            <Stepper Increment="1" Minimum="1" Maximum="10" Value="{Binding ilosc}"></Stepper>
            <Label Text="{Binding stepperValue}"></Label>
            <Switch IsToggled="{Binding isOn}" ></Switch>
            <Label Text="{Binding isOn}" ></Label>
            <Button Text="Oblicz" Clicked="Button_Clicked"></Button>
            <Label Text="{Binding showSum}" x:Name="Wynik"></Label>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
